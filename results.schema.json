{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IGNITION read-only scan results v1",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schemaVersion",
        "status",
        "sourceStatus",
        "servedFromLastComplete",
        "scan",
        "counts",
        "timings",
        "metrics",
        "freshnessMs",
        "candidates"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "status": {
          "const": "empty"
        },
        "sourceStatus": {
          "const": "empty"
        },
        "servedFromLastComplete": {
          "const": false
        },
        "scan": {
          "type": "null"
        },
        "counts": {
          "type": "object"
        },
        "timings": {
          "type": "object"
        },
        "metrics": {
          "type": "object"
        },
        "freshnessMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schemaVersion",
        "status",
        "sourceStatus",
        "servedFromLastComplete",
        "scan",
        "counts",
        "timings",
        "metrics",
        "freshnessMs",
        "candidates"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "paused",
            "complete"
          ]
        },
        "sourceStatus": {
          "enum": [
            "queued",
            "running",
            "paused",
            "complete",
            "failed",
            "cancelled"
          ]
        },
        "servedFromLastComplete": {
          "type": "boolean"
        },
        "scan": {
          "type": "object",
          "required": [
            "id",
            "asOf",
            "finishedAt",
            "partialData",
            "stage"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "asOf": {
              "type": [
                "number",
                "null"
              ]
            },
            "finishedAt": {
              "type": [
                "number",
                "null"
              ]
            },
            "partialData": {
              "type": "boolean"
            },
            "stage": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "counts": {
          "type": "object"
        },
        "timings": {
          "type": "object"
        },
        "metrics": {
          "type": "object"
        },
        "freshnessMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  ]
}
