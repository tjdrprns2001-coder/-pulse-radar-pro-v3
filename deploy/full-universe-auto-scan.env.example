DATABASE_URL=postgres://user:password@host:5432/pulseradar
PG_SSL=1
PORT=8790

# Required for admin-only manual scans
FULL_SCAN_ADMIN_TOKEN=

# Set to the production Pulse Radar origin, e.g. https://example.com
PULSE_ALLOWED_ORIGIN=

# Scanner cadence and limits
FULL_SCAN_TICK_MS=60000
FULL_SCAN_START_DELAY_MS=5000
FULL_SCAN_WORKERS=8
FULL_SCAN_PROVIDER_CONCURRENCY=8
FULL_SCAN_INTERVAL_CONCURRENCY=2
FULL_SCAN_REQUESTS_PER_MINUTE=240
FULL_SCAN_KLINE_ROWS=64
FULL_SCAN_MARKET_CAP_TTL_MS=1800000
FULL_SCAN_WS_SHARD_SIZE=180
FULL_SCAN_PG_POOL_MAX=4
