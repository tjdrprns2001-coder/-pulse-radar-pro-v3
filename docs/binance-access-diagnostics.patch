diff --git a/tests/access-block.test.mjs b/tests/access-block.test.mjs
new file mode 100644
index 0000000..f0e1e85
--- /dev/null
+++ b/tests/access-block.test.mjs
@@ -0,0 +1,19 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {Binance} from '../lib/scanner/binance.mjs';
+import {MemoryStore} from './memory-store.mjs';
+test('403 preserves bounded diagnostic evidence and blocks repeated requests across instances',async()=>{
+ const store=new MemoryStore();let calls=0;
+ const fetcher=async()=>{calls++;return new Response('<html><h1>403 ERROR</h1>Request blocked by CloudFront</html>',{status:403,headers:{server:'CloudFront','content-type':'text/html'}});};
+ const api=new Binance(store,fetcher);
+ await assert.rejects(()=>api.get('/fapi/v1/time'),e=>e.status===403);
+ const diagnostic=await store.get('binance:diagnostic:fapi.binance.com');
+ assert.equal(diagnostic?.status,403);assert.equal(diagnostic?.path,'/fapi/v1/time');assert.match(diagnostic?.reason||'',/CloudFront/);
+ await assert.rejects(()=>new Binance(store,fetcher).get('/fapi/v1/exchangeInfo'),e=>e.status===403);
+ assert.equal(calls,1);
+});
+test('region denial stays an access failure and is never retried or converted to rate limit',async()=>{
+ const store=new MemoryStore();let calls=0;
+ await assert.rejects(()=>new Binance(store,async()=>{calls++;return new Response('{"msg":"Service unavailable from a restricted location"}',{status:451});}).get('/fapi/v1/time'),e=>e.status===451&&/접근 제한/.test(e.message));
+ assert.equal(calls,1);assert.equal((await store.get('binance:diagnostic:fapi.binance.com'))?.status,451);
+});
