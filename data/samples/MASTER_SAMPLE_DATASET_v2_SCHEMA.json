{
  "version": "MASTER_SAMPLE_DATASET_v2",
  "identity": {
    "event_id": "symbol@eventTime; fallback stable id/name when event time unavailable",
    "dedupe": "same event merges evidence and appends source provenance"
  },
  "labels": [
    "SURGE",
    "REIGNITION",
    "PRE_OUTCOME",
    "FAILED_BOS",
    "NO_TRIGGER",
    "CONTROL",
    "POST_SURGE",
    "UNLABELED"
  ],
  "common_features": [
    "price.pre6hPct",
    "price.pre24hPct",
    "price.change24hPct",
    "price.breakout1hPct",
    "oi.m15Pct",
    "oi.h1Pct",
    "oi.h4Pct",
    "oi.h6Pct",
    "oi.h24Pct",
    "oi.post3hPct",
    "taker.pre",
    "taker.preMax",
    "taker.ignition",
    "taker.m5",
    "taker.m15",
    "taker.h1",
    "volume.rvol1h",
    "volume.rvol4h",
    "volume.rvol15m",
    "volume.probeRvol",
    "volume.probeAgeH",
    "volume.postProbeVolRatio",
    "indicators.rsi4h",
    "indicators.rsi1h",
    "indicators.rsi15m",
    "indicators.macd4h",
    "indicators.macd1h",
    "indicators.ma4h",
    "indicators.ma1h",
    "structure.bos4h",
    "structure.bos1h",
    "structure.sweepLow",
    "structure.sweepHigh",
    "structure.route",
    "structure.dna",
    "structure.stage",
    "crossMarket.spotConfirmed",
    "crossMarket.funding",
    "crossMarket.basisPct",
    "outcomes.h1Pct",
    "outcomes.h3Pct",
    "outcomes.h6Pct",
    "outcomes.h12Pct",
    "outcomes.h24Pct",
    "outcomes.h72Pct",
    "outcomes.mfePct",
    "outcomes.maePct"
  ],
  "statistics": {
    "groups": "all + byLabel",
    "measures": [
      "count",
      "median",
      "mean",
      "boolean rate"
    ],
    "purpose": "compare success/reignition/pre-outcome/failure/control distributions without mixing duplicated source records"
  },
  "provenance": "Every normalized event preserves sources[] and provenance[]. Original archives remain untouched."
}
